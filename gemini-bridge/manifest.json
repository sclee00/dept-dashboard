{
  "manifest_version": 3,
  "name": "업무 대시보드 · Gemini 연결",
  "description": "대시보드가 보낸 질문을 내 Gemini 웹 화면(대시보드 안 작은 창 또는 따로 창)에 넣고 답을 받아 대시보드로 돌려줍니다.",
  "version": "1.2.1",
  "icons": {
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://sclee00.github.io/dept-dashboard/*",
        "http://localhost:8765/*"
      ],
      "js": [
        "dashboard.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "run.js",
        "frame.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "업무 대시보드 · Gemini 연결"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "frame",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}